# VAST
VAST_API_KEY=
VAST_MAX_PRICE=
VAST_MAX_CUDA=

# Database
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/diplomatura_cv

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=training-jobs
KAFKA_OUTPUT_TOPIC=model-trained
KAFKA_GROUP_ID=training-service
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_MAX_POLL_INTERVAL_MS=7200000
KAFKA_MAX_POLL_RECORDS=1

# API Gateway
GATEWAY_URL=http://localhost:8000/api/v1/train/

# Training worker
TRAIN_DATASET_SRC=
TRAIN_DATASET_DST=/work/datasets
TRAIN_IMAGE=pytorch/pytorch:2.2.2-cuda12.1-cudnn8-runtime
TRAIN_PORTS=
TRAIN_CMD_BASE=yolo train
TRAIN_DATA=
TRAIN_RUN_CMD=
TRAIN_DATASET_URL=
TRAIN_REMOTE_DOWNLOAD_CMD=curl -L -o /root/taco.tar.gz "{url}"
TRAIN_UPLOAD_RETRIES=8
TRAIN_UPLOAD_BACKOFF=5
TRAIN_SSH_WAIT_SECONDS=0
TRAIN_SSH_TIMEOUT_SECONDS=600
TRAIN_SSH_POLL_SECONDS=5
TRAIN_TCP_TIMEOUT_SECONDS=600
TRAIN_TCP_POLL_SECONDS=5
TRAIN_REMOTE_CHECK=test -f /root/taco.tar.gz
VAST_OFFER_LIMIT=100
TRAIN_ARTIFACT_SRC=
TRAIN_ARTIFACT_DST=./storage/artifacts
TRAIN_LOG_PATH=
TRAIN_LOG_DIR=./storage/artifacts

